{
  "name": "wahlen",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "eslint .",
    "typecheck": "tsc -v && pnpm -r exec tsc --noEmit",
    "dev": "pnpm --filter @wahlen/web dev",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "eslint": "^9.18.0",
    "turbo": "^2.4.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.20.0"
  }
}
